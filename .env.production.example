APP_NAME=RumahKas
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://kas.example.com
# Samakan dengan versi di package.json setiap kali membuat rilis.
APP_VERSION=0.15.0
# Hanya didengarkan di localhost; Cloudflare Tunnel meneruskan ke port ini.
APP_PORT=8080
# Folder persistence pada host CasaOS. Simpan source di subfolder `source`.
APP_DATA_PATH=/DATA/AppData/rumahkas

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=database
DB_PORT=3306
DB_DATABASE=rumahkas
DB_USERNAME=rumahkas
# Gunakan dua password acak yang berbeda dan jangan commit file ini.
DB_PASSWORD=
DB_ROOT_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

ADMIN_NAME="RumahKas Admin"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
